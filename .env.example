# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is git-ignored by default.

# OpenAI — powers the AI Spread Designer (src/lib/aiDesigner.ts)
VITE_OPENAI_API_KEY=

# Google GenAI — used for AI background generation in the editor
VITE_GEMINI_API_KEY=

# Supabase — Auth, Postgres, Storage, Edge Functions
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Edge Function secrets (set on the Supabase project, NOT here):
#   supabase secrets set AWS_REGION=eu-west-1
#   supabase secrets set AWS_ACCESS_KEY_ID=...
#   supabase secrets set AWS_SECRET_ACCESS_KEY=...
#   supabase secrets set AWS_REKOGNITION_COLLECTION_ID=albums-prod
#   supabase secrets set AWS_REKOGNITION_MATCH_THRESHOLD=80
# ─────────────────────────────────────────────────────────────────────────
